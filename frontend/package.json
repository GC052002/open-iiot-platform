{
  "name": "iiot-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend visual (canvas HMI tipo WinCC/Node-RED) de la plataforma IIoT Open Source. F3.0: scaffold + conexión al backend por WS/REST.",
  "type": "module",
  "scripts": {
    "dev": "vite",
